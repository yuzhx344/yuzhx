    parser.add_argument('--extract-only',action='store_true',help='仅生成文件，不启动网站')
    parser.add_argument('--no-browser',action='store_true',help='不自动打开浏览器')
    parser.add_argument('--port',type=int,help='本机访问端口，默认自动选择可用的 3000–3019')
    args=parser.parse_args()
    if sys.version_info<(3,12):parser.exit(1,'需要先安装 Python 3.12 或更新版本。\n')
    target=Path(args.directory).absolute()
    payload=base64.b64decode(ARCHIVE_BASE64)
    if hashlib.sha256(payload).hexdigest()!=ARCHIVE_SHA256:parser.exit(1,'内置交付文件校验失败，请重新获取启动器。\n')
    with zipfile.ZipFile(io.BytesIO(payload)) as archive:
        entries=[]
        for info in archive.infolist():
            path=PurePosixPath(info.filename)
            if path.is_absolute() or not path.parts or path.parts[0]!='FrameFlow-online' or '..' in path.parts:
                parser.exit(1,'内置交付文件的路径无效。\n')
            relative=Path(*path.parts[1:])
            if not relative.parts or info.is_dir():continue
            if ((info.external_attr >> 16) & 0o170000)==0o120000:parser.exit(1,'拒绝符号链接文件。\n')
            entries.append((info,relative))
        if target.exists() or target.is_symlink():
            if target.is_symlink() or not target.is_dir():parser.exit(1,'应用目录不可用。\n')
            for info,relative in entries:
                existing=target/relative
                if existing.is_symlink() or not existing.is_file() or not existing.resolve().is_relative_to(target.resolve()) or hashlib.sha256(existing.read_bytes()).digest()!=hashlib.sha256(archive.read(info)).digest():
                    parser.exit(1,'目标目录存在不同或被修改的文件，为保护原文件不会覆盖。\n请用 --directory 指定新目录；已修改应用可直接运行原 server.py。\n')
            print('已验证现有应用，保留全部数据并重复使用：'+str(target),flush=True)
        else:
            target.mkdir(parents=True,exist_ok=False)
            for info,relative in entries:
                destination=target/relative
                destination.parent.mkdir(parents=True,exist_ok=True)
                with destination.open('xb') as out,archive.open(info) as source:
                    while block:=source.read(1024*1024):out.write(block)
            print('已准备完整在线版：'+str(target),flush=True)
    if args.extract_only:return 0
    candidates=[args.port] if args.port is not None else range(3000,3020)
    selected=None
    for port in candidates:
        if not 1<=port<=65535:parser.exit(1,'端口必须在 1–65535 之间。\n')
        with socket.socket() as probe:
            try:probe.bind(('127.0.0.1',port));selected=port;break
            except OSError:pass
    if selected is None:parser.exit(1,'端口已被占用，请使用 --port 指定其他端口。\n')
    # Default is a local service. Production collaboration deployment uses the included HTTPS instructions.
    address='http://127.0.0.1:'+str(selected)
    app_env={**os.environ,'HOST':'127.0.0.1','PORT':str(selected),'VIDEOQA_DATA':str(target/'.data'),'SECURE_COOKIES':'0','VIDEOQA_SECURE_COOKIE':'0','VIDEOQA_ORIGIN':address}
    print('网站地址：'+address+'\n浏览器将自动打开。保持此窗口运行，按 Ctrl+C 关闭网站。',flush=True)
    process=subprocess.Popen([sys.executable,'server.py'],cwd=target,env=app_env)
    def open_when_ready():
        for _ in range(100):
            if process.poll() is not None:return
            client=http.client.HTTPConnection('127.0.0.1',selected,timeout=1)
            try:
                client.request('GET','/api/health');response=client.getresponse()
                if response.status==200 and json.loads(response.read()).get('service')=='FrameFlow':
                    webbrowser.open(address);return
            except (OSError,ValueError,http.client.HTTPException):pass
            finally:client.close()
            time.sleep(.1)
    if not args.no_browser:threading.Thread(target=open_when_ready,daemon=True).start()
    try:return process.wait()
    except KeyboardInterrupt:return 0
    finally:
        if process.poll() is None:
            process.terminate()
            try:process.wait(timeout=10)
            except subprocess.TimeoutExpired:process.kill();process.wait()
if __name__=='__main__':raise SystemExit(main())
